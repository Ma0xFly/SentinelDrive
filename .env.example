# SentinelDrive local environment template.
# Copy to .env and replace change-me values before running a shared or public deployment.

# Keep development for local use. Set production only after replacing all placeholder secrets.
APP_ENV=development
APP_SECRET_KEY=change-me-development-only

POSTGRES_DB=sentineldrive
POSTGRES_USER=sentineldrive
POSTGRES_PASSWORD=change-me-development-only
DATABASE_URL=postgresql+psycopg://sentineldrive:change-me-development-only@postgres:5432/sentineldrive

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=2
REDIS_MAXMEMORY=256mb

ADMIN_BOOTSTRAP_EMAIL=admin@example.test
ADMIN_BOOTSTRAP_PASSWORD=change-me-development-only

# Optional. Leave empty to run NVD without an API key and stricter rate limits.
NVD_API_KEY=

SOURCE_ENABLED_NVD=true
SOURCE_ENABLED_CISA_KEV=true
SOURCE_ENABLED_VENDOR_ADVISORIES=false
SOURCE_ENABLED_RSS=true
SOURCE_RSS_FEEDS=[]
SOURCE_VENDOR_ADVISORY_ENDPOINTS=
SOURCE_ENABLED_SAMPLE=true
SOURCE_SYNC_INTERVAL_SECONDS=3600
SOURCE_TIMEOUT_SECONDS=20
SOURCE_RATE_LIMIT_PER_MINUTE=20
SOURCE_RETRY_ATTEMPTS=3
READINESS_TIMEOUT_SECONDS=2
RAW_RETENTION_DAYS=90
HTML_RETENTION_MODE=metadata_only
PDF_RETENTION_MODE=metadata_only

CADDY_HOST=localhost
CADDY_TLS_EMAIL=
REVERSE_PROXY_HTTP_PORT=80
REVERSE_PROXY_HTTPS_PORT=443
FRONTEND_UPSTREAM=frontend:3000
BACKEND_UPSTREAM=backend:8000
